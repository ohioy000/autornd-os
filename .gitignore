# Private grounding corpora used for local testing. Real project documentation
# is the point of the grounding experiment and must never reach a public repo —
# keep it here, keep it out of git.
docs/milkhouse/
docs/private*/
evals/private*/
profiles/milkhouse.yaml
profiles/private*.yaml

# Eval results are local measurement records; they reach the repo only by
# deliberate commit (see docs/handover-review.md §13).
evals/results/

# Owner-side agent config, in the .env space: the settings name the coding
# agent and which model drives it, which is the owner's choice and never the
# repo's (the model-name boundary, HANDOVER §0). Untracked like .env itself.
.aider*
