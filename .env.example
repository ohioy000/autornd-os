# ────────────────────────────────────────────────
# AutoRnD-OS Configuration
# Copy to .env and fill in your values
# ────────────────────────────────────────────────

# ── API ──

# OpenRouter API key (required for model access)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter base URL (default works for most users)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Models ──
# All model IDs must contain "/" (provider/model format)

# Triage — fast classification (domains, risk, specialists)
MODEL_TRIAGE=deepseek/deepseek-v4-flash

# Engineering — implement, validate, review, feasibility
MODEL_ENGINEERING=minimax/minimax-m3

# Architecture — planning, critical review
MODEL_ARCHITECTURE=z-ai/glm-5.3-20260816

# Research — knowledge retrieval
MODEL_RESEARCH=google/gemini-2.5-flash

# Escalation — autopsy analysis when iterations exhaust
MODEL_ESCALATION=moonshotai/kimi-k3

# Premium — optional high-end model for Double Check feature
# Leave empty to disable the Double Check button
# MODEL_PREMIUM=

# ── Engine ──

# Max implement/validate iterations before escalation (1-20)
MAX_ITERATIONS=5

# Max tokens for escalation model response
ESCALATION_MAX_TOKENS=4096

# Recovery attempts after escalation directive
ESCALATION_RECOVERY_ATTEMPTS=3

# ── Server ──

# API server bind address and port
API_HOST=0.0.0.0
API_PORT=8100

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ── Database ──

# SQLite database path (async driver)
DATABASE_URL=sqlite+aiosqlite:///./autornd.db

# ── Knowledge ──

# ChromaDB vector store path
CHROMADB_PATH=./chromadb_data

# ── Auth ──

# API key for bearer token auth (optional — leave empty to disable)
# API_KEY=

# JWT secret for user auth (auto-generated if empty)
# JWT_SECRET=

# Allow new user registration (true/false)
REGISTRATION_ENABLED=true

# ── Profile ──

# Project profile name — loads profiles/<name>.yaml
# Leave empty for default generic AutoRnD profile
# AUTORND_PROFILE=
