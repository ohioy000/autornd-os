# OpenRouter API key — required
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database path (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./autornd.db

# API server
API_HOST=0.0.0.0
API_PORT=8100

# Logging
LOG_LEVEL=INFO

# API key for authentication (optional — leave empty to disable auth)
# When set, all API endpoints except / and /api/health require this key
# as a Bearer token in the Authorization header
API_KEY=

# Project profile (optional — leave empty for default, or set to a profile name)
# Profiles are YAML files in the profiles/ directory
AUTORND_PROFILE=
